[Unit]
Description=Aruco Tracker Service
After=network.target

[Service]
Type=simple
User=@JL_USER@
Group=@JL_GROUP@
WorkingDirectory=@JL_WS_ROOT@
ExecStart=/bin/bash @JL_WS_ROOT@/services/start_aruco_tracker.sh
Restart=on-failure
RestartSec=5s
Environment="ROS_LOG_DIR=/var/log/ros2"
# start_aruco_tracker.sh looks for the tracktor-beam workspace next to this one
# and under $HOME; uncomment and set this if yours lives elsewhere.
#Environment="JL_TRACKTOR_BEAM_DIR=/path/to/tracktor-beam"
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=aruco_tracker_service

[Install]
WantedBy=multi-user.target
