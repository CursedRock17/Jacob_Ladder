[Unit]
After=network-online.target
Description=USB Camera Driver

[Service]
Type=simple
User=@JL_USER@
Group=@JL_GROUP@
WorkingDirectory=@JL_WS_ROOT@
ExecStart=/bin/bash @JL_WS_ROOT@/services/run_usb_cam.sh
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=usb_cam_service

[Install]
WantedBy=default.target
