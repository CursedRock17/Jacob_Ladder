[Unit]
Description=ROS 2 PX4 Translation Node
After=network-online.target

[Service]
Type=simple
User=@JL_USER@
Group=@JL_GROUP@
WorkingDirectory=@JL_WS_ROOT@
ExecStart=/bin/bash @JL_WS_ROOT@/services/run_translation_node.sh
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=translation_node_service

[Install]
WantedBy=multi-user.target
