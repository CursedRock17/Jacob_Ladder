[Unit]
Description=Micro-XRCE-DDS-Agent
After=network-online.target
#Requires=sys-devices-platform-bus\x400-3100000.serial-tty-ttyUSB0.device
#After=sys-devices-platform-bus\x400-3100000.serial-tty-ttyUSB0.device syslog.target network-online.target

[Service]
Type=simple
User=@JL_USER@
Group=@JL_GROUP@
WorkingDirectory=@JL_WS_ROOT@
ExecStart=/bin/bash @JL_WS_ROOT@/services/run_dds_agent.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dds_agent_service

[Install]
WantedBy=multi-user.target
