<?xml version="1.0" encoding="UTF-8"?>
<!--
  AprilTag, family tag36h11, id 0. The black square is 0.30 m on a side (what
  aruco_tracker's marker_size means), inside a 0.36 m white plate that gives
  the detector its quiet zone. The plate faces +Z; rotate it to hang it on a wall.
  The texture comes from OpenCV's DICT_APRILTAG_36h11 (dictionary 20 in aruco_tracker).
-->
<sdf version="1.9">
  <model name="apriltag_36h11_id0">
    <static>true</static>
    <link name="tag_link">
      <visual name="tag_visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.36 0.36</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://apriltag_36h11_id0/materials/textures/apriltag_36h11_id0.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
