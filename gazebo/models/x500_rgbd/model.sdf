<?xml version="1.0" encoding="UTF-8"?>
<!--
  An x500 with a forward-facing RGB-D camera, modelled on an Intel RealSense D435.

  One rgbd_camera sensor gives colour, depth and a point cloud from the same
  viewpoint, so the depth is already aligned to the colour image. Gazebo
  publishes them on /realsense/{image,depth_image,points,camera_info}; run
  gazebo/launch/rgbd_bridge.launch.py to get them in ROS under the names the
  real realsense2_camera driver uses.

  Simulated here: the D435's RGB field of view (69 x 42 degrees) at 640x480, 30 Hz,
  and a depth range of 0.3 to 10 m. Not simulated: stereo matching artefacts, IR
  projector, or the colour/depth field-of-view difference.
-->
<sdf version='1.9'>
  <model name='x500_rgbd'>
    <self_collide>false</self_collide>
    <include merge='true'>
      <uri>x500</uri>
    </include>

    <!-- The link carries the mounting pose. A fixed joint's own <pose> does not move
         the child link, so putting the offset only there leaves the camera at the origin. -->
    <link name="rgbd_camera_link">
      <pose relative_to="base_link">0.12 0 0.05 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.072</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00005</iyy>
          <iyz>0</iyz>
          <izz>0.00005</izz>
        </inertia>
      </inertial>
      <!-- 90 x 25 x 25 mm body, like the D435 -->
      <visual name="rgbd_camera/visual/body">
        <geometry>
          <box>
            <size>0.025 0.09 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
      <visual name="rgbd_camera/visual/glass">
        <pose>0.0128 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.001 0.085 0.015</size>
          </box>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.04 1</ambient>
          <diffuse>0.02 0.02 0.04 1</diffuse>
          <specular>1 1 1 1</specular>
        </material>
      </visual>
      <sensor name="rgbd_camera" type="rgbd_camera">
        <pose>0.0125 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.2043</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.3</near>
            <far>10</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.3</near>
              <far>10</far>
            </clip>
          </depth_camera>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>realsense</topic>
        <gz_frame_id>camera_link</gz_frame_id>
      </sensor>
      <gravity>true</gravity>
      <velocity_decay/>
    </link>

    <joint name="rgbd_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>rgbd_camera_link</child>
    </joint>
  </model>
</sdf>
